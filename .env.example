# LLM provider
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5

# Gemini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash-lite

# TTS provider: "elevenlabs" (default) or "openai"
TTS_PROVIDER=elevenlabs

# ElevenLabs (Railway worker only)
ELEVENLABS_API_KEY=...

# OpenAI TTS (alternative to ElevenLabs — instructable voice delivery)
OPENAI_API_KEY=sk-...
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Video codec: "h265" (better quality/size) or "h264" (wider compat)
VIDEO_CODEC=h265

# Clerk
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_PAY_PER_VIDEO_PRICE_ID=price_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/listingreel?sslmode=require

# Upstash Redis / QStash
UPSTASH_REDIS_URL=https://xxx.upstash.io
UPSTASH_REDIS_TOKEN=...
QSTASH_TOKEN=...
QSTASH_CURRENT_SIGNING_KEY=...
QSTASH_NEXT_SIGNING_KEY=...

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=listingreel-videos
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# App
NEXT_PUBLIC_APP_URL=https://listingreel.com
WORKER_URL=https://worker.railway.internal
WORKER_SECRET=...
GUEST_MODE=false

# Twilio SMS / MMS intake
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WEBHOOK_URL=https://listingreel.com/api/twilio/inbound

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@listingreel.com
